<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="480.0" prefWidth="400.0" spacing="20.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quiznodes.debug.DebugController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>
        <!-- Title -->
        <Label styleClass="main-title" text="QuizNodes - Debug" />

        <Label styleClass="card-title" text="Available Servers" />

        <ListView fx:id="serverListView" styleClass="dark-list-view" VBox.vgrow="ALWAYS" />

        <VBox spacing="8.0" alignment="CENTER_LEFT">
            <Label fx:id="quizCountLabel" styleClass="card-title" text="Number of quizzes: 0" />

            <Label fx:id="capacityLabel" styleClass="card-title" text="Available capacity: 0" />
        </VBox>

        <!-- Centered Connect button -->
        <HBox alignment="CENTER" spacing="15.0">
            <Button fx:id="spawnBtn" mnemonicParsing="false" onAction="#handleSpawn" prefHeight="42.0" prefWidth="124.0" styleClass="primary-button" text="Spawn Server" />
            <Button fx:id="shutdownBtn" mnemonicParsing="false" onAction="#handleShutdown" styleClass="primary-button" text="Shutdown server" />
            <Button fx:id="sleepBtn" mnemonicParsing="false" onAction="#handleSleep" styleClass="primary-button" text="Sleep server" />
            <Button fx:id="shutdownAllBtn" mnemonicParsing="false" onAction="#handleShutdownAll" styleClass="primary-button" text="Shutdown All Servers" />
        </HBox>
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="520.0" prefWidth="480.0" spacing="20.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quiznodes.client.QuizController">

    <padding>
        <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
    </padding>

    <children>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label fx:id="quizTitleLabel" styleClass="main-title" text="Quiz" HBox.hgrow="ALWAYS" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="progressLabel" styleClass="status-label" text="Question 1 / 5" />
            <Label fx:id="scoreLabel" styleClass="status-label" text="Score: 0" />
            </children>
        </HBox>

        <Separator />

        <VBox spacing="18.0" styleClass="card" VBox.vgrow="ALWAYS">
            <children>

                <Label fx:id="questionLabel" styleClass="card-title" text="Question text goes here" wrapText="true" />

                <VBox fx:id="choicesBox" spacing="10.0" />

            </children>
        </VBox>

        <Label fx:id="feedbackLabel" styleClass="status-label" text="" wrapText="true" />

        <HBox alignment="CENTER" spacing="12.0">
            <children>
                <Button fx:id="submitBtn" mnemonicParsing="false" onAction="#handleSubmit" styleClass="primary-button" text="Submit" />
                <Button fx:id="nextBtn" managed="false" mnemonicParsing="false" onAction="#handleNext" styleClass="primary-button" text="Next →" visible="false" />
            </children>
        </HBox>

    </children>
</VBox>
